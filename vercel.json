{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["gru1"],
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": "{frontend/**,backend/app/core/postgres_schema.sql}",
      "excludeFiles": "{data/**,output/**,tests/**,docs/**,.venv/**,venv/**,.env,.env.*,.git/**}"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{"key": "Cache-Control", "value": "private, no-store"}]
    }
  ]
}
