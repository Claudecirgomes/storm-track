# SQLite remains the default when STORMTRACK_DATABASE_URL is empty.
STORMTRACK_DATA_DIR=./data
STORMTRACK_DATABASE_URL=
STORMTRACK_COLLECTION_ENABLED=false
STORMTRACK_COLLECTION_INTERVAL_SECONDS=60
STORMTRACK_SESSION_TTL_MINUTES=60
# Future PostgreSQL/Supabase: copy the direct/session connection URL into backend
# environment only. Use port 5432 and SSL. Never put a database password in frontend.
# This file documents variables; the app does not automatically load .env files.
# Vercel: set STORMTRACK_DATABASE_URL and STORMTRACK_COLLECTION_ENABLED=false
# in the project environment settings. VERCEL=1 is provided by the platform.
# The cloud database must be migrated before the first deployment is used.
# Local GOES extension (never put machine/admin secrets in frontend files)
STORMTRACK_SATELLITE_PROFILE=basic
STORMTRACK_SATELLITE_COLLECT_RGB=false
STORMTRACK_RESEARCH_MAX_BYTES=2147483648
